{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "EAS_NO_VCS": "1"
      }
    },
    "ios-device": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "EAS_NO_VCS": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
