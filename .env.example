# ============================================================
# Memory Machine — Required Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# --- Clerk Auth (get from clerk.com dashboard) ---
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...   # From Clerk Dashboard → Webhooks → Signing Secret

# --- Encryption (generate with: openssl rand -hex 32) ---
ENCRYPTION_ROOT_SECRET=<64-char hex string>

# --- Session ---
SESSION_SECRET=<random string, min 32 chars>

# --- Server ---
PORT=8080
NODE_ENV=production

# --- Web Frontend (Vite — prefix with VITE_) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# --- Mobile (Expo — prefix with EXPO_PUBLIC_) ---
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
EXPO_PUBLIC_DOMAIN=https://your-api-domain.replit.app

# --- Sentry (Android / iOS crash reporting) ---
# Create 2 projects at sentry.io: leo-app and memory-machine under org livhappierapps
# Client DSN is public-ish (bundled in the APK). Auth token is secret — CI only.
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_KEY@o0.ingest.sentry.io/0
SENTRY_ORG=livhappierapps
SENTRY_PROJECT=leo-app
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=production

# ============================================================
# NOTES:
# - ENCRYPTION_ROOT_SECRET: keep this safe forever.
#   Losing it = losing access to all encrypted messages.
# - DATABASE_URL: Neon (neon.tech) is what Replit uses.
#   Free tier works for dev; paid for production.
# - Clerk: create a new app at clerk.com for your own tenant.
# ============================================================
