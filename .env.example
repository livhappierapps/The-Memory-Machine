# ============================================================
# Memory Machine — Required Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# --- Clerk Auth (get from clerk.com dashboard) ---
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...   # From Clerk Dashboard → Webhooks → Signing Secret

# --- Encryption (generate with: openssl rand -hex 32) ---
ENCRYPTION_ROOT_SECRET=<64-char hex string>

# --- Session ---
SESSION_SECRET=<random string, min 32 chars>

# --- Server ---
PORT=8080
NODE_ENV=production

# --- Web Frontend (Vite — prefix with VITE_) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# --- Mobile (Expo — prefix with EXPO_PUBLIC_) ---
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
EXPO_PUBLIC_DOMAIN=https://your-api-domain.replit.app

# --- Embeddings (semantic memory search) ---
# Server-level fallback key used when a profile has no embedding key of its own.
XAI_API_KEY=
# EMBEDDING_API_KEY=            # optional; overrides XAI_API_KEY for embeddings only
# OPENAI_EMBEDDING_API_KEY=     # optional; for profiles with embedding provider = openai
XAI_EMBEDDING_MODEL=v1          # verify with: pnpm --filter @workspace/api-server run embeddings:probe
EMBEDDING_DIM=1536              # must match the model; empty embeddings table is migrated at boot
# EMBEDDING_SEND_DIMENSIONS=false  # if the provider rejects the `dimensions` field
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# NOTES:
# - ENCRYPTION_ROOT_SECRET: keep this safe forever.
#   Losing it = losing access to all encrypted messages.
# - DATABASE_URL: Neon (neon.tech) is what Replit uses.
#   Free tier works for dev; paid for production.
# - Clerk: create a new app at clerk.com for your own tenant.
# ============================================================
