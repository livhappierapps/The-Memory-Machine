{
  "expo": {
    "name": "The Memory Machine (Mobile)",
    "slug": "thememorymachinemobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thememorymachinemobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#2f2f37",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2f2f37"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thememorymachinemobile.app"
    },
    "android": {
      "package": "com.thememorymachinemobile.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#2f2f37"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1ad4be",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}