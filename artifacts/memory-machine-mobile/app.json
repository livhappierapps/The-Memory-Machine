{
  "expo": {
    "name": "The Memory Machine",
    "slug": "thememorymachinemobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thememorymachinemobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#2f2f37",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2f2f37"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thememorymachinemobile.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The Memory Machine uses the microphone for voice messages.",
        "NSCameraUsageDescription": "The Memory Machine uses the camera to attach images to conversations.",
        "NSPhotoLibraryUsageDescription": "The Memory Machine uses your photo library to attach images to conversations."
      }
    },
    "android": {
      "package": "com.thememorymachinemobile.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#2f2f37"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1ad4be",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
